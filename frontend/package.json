{
  "name": "club-system-plus-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:poc": "vite --config vite.poc.config.mjs",
    "build:poc": "tsc -p poc/tsconfig.json && vite build --config vite.poc.config.mjs",
    "test:poc": "node --test poc/server.test.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@react-leaflet/core": "^3.0.0",
    "@types/leaflet": "^1.9.21",
    "axios": "^1.13.2",
    "leaflet": "^1.9.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.9.6",
    "vite": "^7.2.4"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3"
  }
}
